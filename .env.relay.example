# Relay

# REQUIRED: Authentication key matching the Relay configured in Hearth
# Generate with: openssl rand -base64 48
KILN_RELAY_KEY=

# OPTIONAL: Separate recovery key for encrypted Kiln platform backups.
# The colocated Hearth Compose stack passes this to Relay automatically.
# Generate with: openssl rand -base64 48
KILN_PLATFORM_BACKUP_KEY=

# OPTIONAL: Public Relay control hostname advertised to Hearth and browsers.
KILN_RELAY_HOST=

# OPTIONAL: Hostname or IP advertised for game server ports. Leave empty to
# use the resolved KILN_RELAY_HOST. Set to public-ip to discover the Relay's
# public IPv4 address at startup.
KILN_RELAY_GAME_HOST=

# OPTIONAL: Host ports assigned to newly created game servers. Forward and
# allow this range through the Relay host firewall/NAT.
# DEFAULT: 30000-39999
KILN_RELAY_GAME_PORT_RANGE=30000-39999

# OPTIONAL: Number of automatic restarts after an unexpected game-server exit.
# Set to 0 to disable automatic crash recovery.
# DEFAULT: 2
KILN_RELAY_CRASH_RETRY_LIMIT=2

# OPTIONAL: Delay before the first recovery attempt. Later attempts use a
# bounded exponential delay.
# DEFAULT: 5
KILN_RELAY_CRASH_RETRY_DELAY_SECONDS=5

# OPTIONAL: Healthy runtime required before Relay resets the retry budget.
# DEFAULT: 300
KILN_RELAY_CRASH_STABILITY_SECONDS=300

# OPTIONAL: Relay API listen port
# DEFAULT: 4100
KILN_RELAY_PORT=4100

# OPTIONAL: Versioned Brick catalog. HTTPS is required unless an operator
# explicitly configures a local file: URL for an air-gapped installation.
# DEFAULT: official catalog in kiln-site/hearth
KILN_BRICKS_CATALOG_URL=https://raw.githubusercontent.com/kiln-site/hearth/main/apps/bricks/catalog.yml

# Sentry

# OPTIONAL: Enables Sentry for Relay errors and traces. When empty, Sentry is
# disabled.
SENTRY_DSN=

# OPTIONAL: Fraction of Relay transactions captured (0–1).
# DEFAULT: 0.1 in production, 1 in development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Relay stores persistent data in /data.
# Mount /var/run/docker.sock and a persistent volume at /data.
# Health checks can use GET /health without authentication.
